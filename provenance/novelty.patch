@@ -1,4 +1,7 @@
-"""GPU, RAM and Windows commit sampling, the low-commit safe stop, and keeping the PC awake."""
+"""GPU, RAM and commit sampling, the low-commit safe stop, and keeping the PC awake.
+
+Cross-platform (2026-11-19, for running on a remote Linux GPU server): on Windows the values are the original Windows
+commit figures; elsewhere commit = RAM + swap from psutil. No effect on the algorithm."""
 from __future__ import annotations
 
 import csv
@@ -24,6 +27,10 @@ class _MemoryStatus(ctypes.Structure):
 
 
 def memory_snapshot() -> Dict[str, float]:
+    if os.name != "nt":
+        vm, sw, gb = psutil.virtual_memory(), psutil.swap_memory(), 2**30
+        return {"ram_free_gb": vm.available / gb, "commit_limit_gb": (vm.total + sw.total) / gb,
+                "commit_free_gb": (vm.available + sw.free) / gb}
     status = _MemoryStatus()
     status.dwLength = ctypes.sizeof(_MemoryStatus)
     ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status))
@@ -41,7 +48,9 @@ def gpu_snapshot() -> Dict[str, float]:
 
 
 def keep_awake(enable: bool) -> None:
-    """Stop Windows from sleeping during the run; released when the process ends."""
+    """Stop Windows from sleeping during the run; released when the process ends. No-op elsewhere."""
+    if os.name != "nt":
+        return
     flags = ES_CONTINUOUS | (ES_SYSTEM_REQUIRED if enable else 0)
     ctypes.windll.kernel32.SetThreadExecutionState(flags)
 
